#==============================================================================
# Doxygen configuration for Unity project
#==============================================================================

#------------------------------------------------------------------------------
# Project
#------------------------------------------------------------------------------

PROJECT_NAME           = "TFG2 Voxel Editor"

PROJECT_BRIEF          = "Documentation for the TFG2 Voxel Editor Unity project."

PROJECT_NUMBER         =

PROJECT_LOGO           =

OUTPUT_DIRECTORY       = Documentation

CREATE_SUBDIRS         = NO


#------------------------------------------------------------------------------
# Build
#------------------------------------------------------------------------------

# Doxygen's current working directory is the Unity project root.
# Paths below are therefore relative to the project root.

FULL_PATH_NAMES        = YES

STRIP_FROM_PATH        = .

STRIP_FROM_INC_PATH    =


#------------------------------------------------------------------------------
# Input
#------------------------------------------------------------------------------

# Document the project's C# source code.
#
# If you want ALL of Assets documented:
INPUT = Assets/Scripts/

# Search subdirectories recursively.
RECURSIVE              = YES

# Only process C# files.
FILE_PATTERNS          = *.cs

# Exclude Unity-generated/project directories and other irrelevant files.
EXCLUDE                = Assets/Plugins \
                         Assets/ThirdParty \
                         Assets/Packages \
                         Assets/StreamingAssets

EXCLUDE_PATTERNS       = */Library/* \
                         */Temp/* \
                         */Logs/* \
                         */obj/* \
                         */bin/* \
                         */.git/* \
                         */Packages/*


#------------------------------------------------------------------------------
# Source extraction
#------------------------------------------------------------------------------

# Document entities even if they don't have /// documentation.
EXTRACT_ALL            = YES

# Include undocumented members.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# Include static members.
EXTRACT_STATIC         = YES

# Include internal/protected/private members in the documentation.
HIDE_UNDOC_MEMBERS     = NO

# Don't hide undocumented classes.
HIDE_UNDOC_CLASSES     = NO


#------------------------------------------------------------------------------
# C# / source code parsing
#------------------------------------------------------------------------------

# Enable preprocessing so Doxygen can understand conditional compilation
# such as #if UNITY_EDITOR.
ENABLE_PREPROCESSING   = YES

MACRO_EXPANSION        = YES

EXPAND_ONLY_PREDEF     = NO

SEARCH_INCLUDES        = YES

INCLUDE_PATH           =


# Unity defines many symbols which Doxygen doesn't know about.
#
# These are primarily useful for parsing Unity-specific conditional code.
PREDEFINED             = UNITY_2021_1_OR_NEWER \
                         UNITY_2022_1_OR_NEWER \
                         UNITY_6000_0_OR_NEWER \
                         UNITY_EDITOR \
                         UNITY_EDITOR_WIN \
                         UNITY_STANDALONE \
                         UNITY_STANDALONE_WIN \
                         DEVELOPMENT_BUILD


#------------------------------------------------------------------------------
# Documentation extraction
#------------------------------------------------------------------------------

# Use /// XML documentation comments in C#.
JAVADOC_AUTOBRIEF      = YES

QT_AUTOBRIEF           = NO

MULTILINE_CPP_IS_BRIEF = NO

INHERIT_DOCS           = YES

INLINE_INHERITED_MEMB  = YES

DISTRIBUTE_GROUP_DOC   = NO

SEPARATE_MEMBER_PAGES  = NO

TAB_SIZE               = 4


#------------------------------------------------------------------------------
# Source browser
#------------------------------------------------------------------------------

SOURCE_BROWSER          = YES

INLINE_SOURCES         = NO

REFERENCED_BY_RELATION = YES

REFERENCES_RELATION    = YES

REFERENCES_LINK_SOURCE = YES

VERBATIM_HEADERS       = NO


#------------------------------------------------------------------------------
# Alphabetical index
#------------------------------------------------------------------------------

ALPHABETICAL_INDEX     = YES

COLS_IN_ALPHA_INDEX    = 5

IGNORE_PREFIX          =


#------------------------------------------------------------------------------
# HTML output
#------------------------------------------------------------------------------

GENERATE_HTML          = YES

HTML_OUTPUT            = html

HTML_TIMESTAMP         = YES

HTML_DYNAMIC_MENUS     = YES

HTML_COLORSTYLE        = AUTO_LIGHT

GENERATE_TREEVIEW      = YES

TREEVIEW_WIDTH         = 250

DISABLE_INDEX          = NO

GENERATE_DOCSET        = NO

GENERATE_HTMLHELP      = NO

GENERATE_QHP           = NO

GENERATE_ECLIPSEHELP  = NO


#------------------------------------------------------------------------------
# LaTeX / PDF
#------------------------------------------------------------------------------

# Disable LaTeX for now.
# Enable this later if you want Doxygen -> LaTeX -> PDF documentation.
GENERATE_LATEX         = NO


#------------------------------------------------------------------------------
# Diagrams / Graphviz
#------------------------------------------------------------------------------

# Enable Graphviz-generated diagrams if Graphviz is installed.
HAVE_DOT               = YES

DOT_NUM_THREADS        = 0

CLASS_DIAGRAMS         = YES

UML_LOOK               = YES

UML_LIMIT_NUM_FIELDS   = 50

TEMPLATE_RELATIONS     = YES

INCLUDE_GRAPH          = YES

INCLUDED_BY_GRAPH      = YES

CALL_GRAPH             = YES

CALLER_GRAPH           = YES

GRAPHICAL_HIERARCHY    = YES

DIRECTORY_GRAPH        = YES

DOT_IMAGE_FORMAT       = svg

INTERACTIVE_SVG        = YES

DOT_CLEANUP            = YES


#------------------------------------------------------------------------------
# Class / namespace documentation
#------------------------------------------------------------------------------

SHOW_GROUPED_MEMB_INC  = YES

SORT_MEMBER_DOCS       = YES

SORT_BRIEF_DOCS        = NO

SORT_MEMBERS_CTORS_1ST = YES

SORT_MEMBERS_CTORS_1ST = YES

SORT_BY_SCOPE_NAME     = YES

SORT_BRIEF_DOCS        = NO


#------------------------------------------------------------------------------
# Warnings
#------------------------------------------------------------------------------

QUIET                  = NO

WARNINGS               = YES

WARN_IF_UNDOCUMENTED   = YES

WARN_IF_DOC_ERROR      = YES

WARN_NO_PARAMDOC       = NO

WARN_AS_ERROR          = NO

WARN_FORMAT            = "$file:$line: $text"

WARN_LOGFILE           =


#------------------------------------------------------------------------------
# XML output
#------------------------------------------------------------------------------

# Disabled because HTML is the primary output.
GENERATE_XML           = NO


#------------------------------------------------------------------------------
# Search / indexing
#------------------------------------------------------------------------------

SEARCHENGINE           = YES

SERVER_BASED_SEARCH    = NO


#------------------------------------------------------------------------------
# Advanced
#------------------------------------------------------------------------------

GENERATE_TAGFILE       =

ENABLE_PREPROCESSING   = YES

CLANG_ASSISTED_PARSING = NO

CLANG_OPTIONS          =

CLANG_DATABASE_PATH    =